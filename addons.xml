<?xml version="1.0" encoding="UTF-8"?>
<addons>
<addon id="plugin.video.indiancatalog" name="Indian Cinema Catalog" version="0.0.9" provider-name="me">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
  </requires>
  <extension point="xbmc.python.pluginsource" library="main.py">
    <provides>video</provides>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Indian cinema catalog</summary>
    <description lang="en_GB">Browse Indian movies by language using TMDB. Streams come from your own AIOStreams URL.</description>
    <platform>all</platform>
    <assets>
      <icon>icon.png</icon>
      <fanart>fanart.png</fanart>
    </assets>
  </extension>
</addon>
<addon id="repository.indiancatalog" name="Indian Cinema Catalog Repository" version="1.0.0" provider-name="me">
  <requires>
    <import addon="xbmc.addon" version="12.0.0"/>
  </requires>
  <extension point="xbmc.addon.repository" name="Indian Cinema Catalog Repository">
    <dir>
      <info compressed="false">https://raw.githubusercontent.com/tsquare2811-ui/kodi-indian-catalog/main/addons.xml</info>
      <checksum>https://raw.githubusercontent.com/tsquare2811-ui/kodi-indian-catalog/main/addons.xml.md5</checksum>
      <datadir zip="true">https://raw.githubusercontent.com/tsquare2811-ui/kodi-indian-catalog/main/zips/</datadir>
    </dir>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Indian Cinema Catalog repository</summary>
    <description lang="en_GB">Updates for the Indian Cinema Catalog add-on.</description>
    <platform>all</platform>
  </extension>
</addon>
</addons>
